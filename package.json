{
  "name": "n-serving",
  "version": "0.1.0",
  "private": true,
  "description": "N-Serving ML Serving Platform FE",
  "scripts": {
    "================== 퍼블 컴포넌트 확인 및 Build ==================": "",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "================== 개발 서버 실행 ==================": "",
    "dev": "node scripts/buildCheck.cjs dev && next dev",
    "================== 배포 빌드 및 서버 실행 ==================": "",
    "build": "node scripts/buildCheck.cjs build && npm run lint && next build && node scripts/buildCheck.cjs done",
    "start": "node scripts/buildCheck.cjs start && next start",
    "================== 빌드 후 배포 모드 확인 ==================": "",
    "preview": "npm run build && npm run start",
    "================== 다국어 사전 타입 생성 및 키추가 ==================": "",
    "gen:dict": "tsx scripts/generate-dict-types.ts",
    "dict:add": "tsx scripts/add-dict-key.ts",
    "dict:watch": "tsx scripts/generate-dict-types.ts --watch",
    "predev": "npm run gen:dict",
    "prebuild": "npm run gen:dict",
    "================== 소스코드검증 ==================": "",
    "check": "npx tsc --noEmit && npm run build",
    "lint": "next lint",
    "================== 빌드 결과물 용량 분석 ==================": "",
    "analyze": "cross-env ANALYZE=true next build"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.9.0",
    "@uiw/react-codemirror": "^4.24.0",
    "axios": "^1.7.7",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "critters": "^0.0.23",
    "dayjs": "^1.11.19",
    "devextreme": "24.1.6",
    "devextreme-react": "24.1.6",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "negotiator": "^1.0.0",
    "next": "15.3.6",
    "next-auth": "^4.24.11",
    "papaparse": "^5.5.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "rimraf": "^6.1.3",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.21.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "^16.2.0",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/nextjs": "^10.4.6",
    "@types/file-saver": "^2.0.7",
    "@types/negotiator": "^0.6.3",
    "@types/node": "^20",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.27",
    "babel-plugin-react-compiler": "^1.0.0",
    "chalk": "^4.1.2",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.3.3",
    "ora": "^5.4.1",
    "storybook": "^10.4.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5"
  }
}
