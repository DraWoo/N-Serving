{
  "name": "n-serving",
  "version": "0.1.0",
  "private": true,
  "description": "N-Serving 프론트엔드: 퍼블 화면과 기존 인증·업무 기능을 통합하는 프로젝트",
  "scripts": {
    "dev": "node scripts/banner.cjs dev && next dev",
    "build": "node scripts/banner.cjs build && npm run lint && next build && node scripts/banner.cjs done",
    "start": "node scripts/banner.cjs start && next start",
    "preview": "npm run build && npm run start",
    "lint": "eslint .",
    "check:types": "tsc --noEmit",
    "check": "npm run gen:dict && npm run lint && npm run check:types && npm run build",
    "analyze": "cross-env ANALYZE=true npm run build",
    "clean": "rimraf .next out node_modules/.cache",
    "gen:dict": "node --import tsx scripts/generate-dict-types.mjs",
    "predev": "npm run gen:dict",
    "prebuild": "npm run gen:dict",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.9.0",
    "@uiw/react-codemirror": "^4.24.0",
    "axios": "^1.7.7",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "critters": "^0.0.23",
    "dayjs": "^1.11.19",
    "devextreme": "24.1.6",
    "devextreme-react": "24.1.6",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "negotiator": "^1.0.0",
    "next": "15.3.6",
    "next-auth": "^4.24.11",
    "papaparse": "^5.5.2",
    "react": "19.0.1",
    "react-dom": "19.0.1",
    "rimraf": "^6.1.3",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.21.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@next/bundle-analyzer": "15.3.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/nextjs": "^10.4.6",
    "@types/file-saver": "^2.0.7",
    "@types/negotiator": "^0.6.3",
    "@types/node": "^20",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.27",
    "babel-plugin-react-compiler": "^1.0.0",
    "chalk": "^4.1.2",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "15.3.6",
    "ora": "^5.4.1",
    "storybook": "^10.4.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5"
  }
}